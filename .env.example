# ============================================================
# aceHRM backend — one-click deploy config
# Copy to .env, fill in real values, then run ./setup.sh (or setup.ps1).
# NEVER commit .env to source control.
# ============================================================

# ── Database ──────────────────────────────────────────────
# DATABASE_URL is set automatically by docker-compose (points at the db service).
POSTGRES_PASSWORD=change-me

# ── nodejs-backend ──────────────────────────────────────────
PORT=5000
AGENT_JWT_SECRET=change-me

# ── python-microservice (ZKTeco attendance device) ───────────
# The laptop running this stack must be on the same LAN as the device.
DEVICE_IP=192.168.18.101
DEVICE_PORT=4370
COMM_KEY=11

# ── Cloudflare Tunnel ──────────────────────────────────────
# Zero Trust dashboard → Networks → Tunnels → your tunnel → Configure → copy the token.
# Add a Public Hostname routing to http://nodejs-backend:5000
# Reuse the SAME token on every laptop that should be able to serve this stack.
CLOUDFLARE_TUNNEL_TOKEN=put-your-tunnel-token-here
