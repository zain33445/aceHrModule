# API base used by the Electron *main* process and as the fallback for the
# browser app. The LAN address is used so the agent also works from other
# devices on the office network.
VITE_API_BASE=http://192.168.18.65:5000/api
# VITE_API_BASE=http://localhost:5000/api
# VITE_API_BASE=https://api.theaceservices.site/api

# Set to 1 in development so the browser app talks to the Vite dev server
# (/api and the WebSocket gateways) instead of the backend directly. The dev
# server proxies those to the backend, which keeps the page same-origin —
# required when the dev server is served over HTTPS, because a secure page
# may not call a plain-HTTP API.
VITE_USE_PROXY=1

# Largest group call the mesh supports. Keep in step with the backend's
# CALL_MAX_PARTICIPANTS — the mesh is only reliable up to three people.
VITE_MAX_CALL_PARTICIPANTS=3
